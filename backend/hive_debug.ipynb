   "source": [
    "ingest_results = []\n",
    "for item in texts:\n",
    "    try:\n",
    "        result = await orchestrator.run(mode=\"submit\", text=item[\"text\"], environment_hint=\"auto\")\n",
    "    except Exception:\n",
    "        number_of_words = word_counter(item[\"text\"])\n",
    "        chunk_size = int(floor(number_of_words * 0.2))\n",
    "        chunk_overlap = int(floor(number_of_words * 0.005))\n",
    "        splitter = TextSplitter(\n",
    "            chunk_size=chunk_size,\n",
    "            chunk_overlap=chunk_overlap,\n",
    "        )\n",
    "        chunks = splitter.produce_chunks(item[\"text\"])\n",
    "        for chunk in chunks:\n",
    "            result = await orchestrator.run(mode=\"submit\", text=chunk, environment_hint=\"auto\")\n",
    "            persisted_list = result.get(\"persisted\", [])\n",
    "            ingest_results.append({\n",
    "                \"file\": item[\"name\"],\n",
    "                \"num_concepts_extracted\": len(persisted_list),\n",
    "                \"knowledge_entry_ids\": [entry.get(\"knowledge_entry_id\") for entry in persisted_list],\n",
    "                \"errors\": result.get(\"errors\", []),\n",
    "            })\n",
    "\n",
    "print(json.dumps(ingest_results, indent=2))"
   ]
  }
